# Browser key: restrict to Maps JavaScript API and your website HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Google Cloud map ID; DEMO_MAP_ID is used for local development otherwise.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Private server key: enable/restrict to Routes API and Places API (New).
# Apply server IP restrictions when deploying with a stable outbound IP.
GOOGLE_MAPS_API_KEY=
