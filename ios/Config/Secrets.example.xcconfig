// Copy to Secrets.xcconfig, or run scripts/sync-secrets.sh. Never commit Secrets.xcconfig.
// Maps SDK for iOS key, restricted to iOS apps with this bundle ID.
WALLY_GOOGLE_MAPS_SDK_KEY = your_maps_sdk_key
// Places API (New) and Routes API key. The app sends X-Ios-Bundle-Identifier,
// so you can restrict this key to iOS apps with this bundle ID too.
WALLY_GOOGLE_PLACES_ROUTES_KEY = your_places_routes_key
// Optional iOS map ID. A JavaScript map ID does not style an iOS map.
WALLY_GOOGLE_MAPS_MAP_ID =
